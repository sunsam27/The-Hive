PORT=3001
NODE_ENV=development

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/the_hive

# JWT
JWT_SECRET=change-me-to-a-random-secret
JWT_EXPIRES_IN=7d

# Frontend URL (used for CORS + email links)
# In production: set to your Vercel deployment URL
FRONTEND_URL=http://localhost:5173

# Extra browser origins allowed to call the API (comma separated).
# Use this for custom domains, e.g. https://finsyte.app,https://www.finsyte.app
ALLOWED_ORIGINS=

# Vercel project names allowed to reach the API from preview deployments.
# Preview URLs look like <project>-<hash>.vercel.app, so they cannot all be
# listed individually. Add your project name here if you rename it in Vercel,
# otherwise browser calls from preview deployments fail with a CORS error.
VERCEL_PROJECT_PREFIXES=the-hive,finsyte

# Brevo (email)
# Get a free API key at https://brevo.com
BREVO_API_KEY=xkeysib-xxxxxxxxxxxx

# OCR.space (receipt scanning)
# Get a free API key at https://ocr.space/ocrapi
OCR_SPACE_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Cloudinary (file storage)
# Get credentials at https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Payments
# Finsyte automatically routes each payment by currency, so no client-side choice
# is needed and the end user never sees a gateway. African currencies go to
# Flutterwave, everything else to Stripe.
#
# IMPORTANT: The same values must be configured in each provider's dashboard,
# and the signing secret must match exactly or every webhook is rejected.

# Platform fee, charged on top of the expense amount
# The client pays the fee, so it is never silently deducted from a freelancer.
PLATFORM_FEE_RATE=0.02
# Minimum fee in the charge currency, applied when the percentage is lower.
PLATFORM_FEE_MIN=1
# Optional per-currency overrides, e.g. a 1.00 minimum is negligible in NGN.
# PLATFORM_FEE_MIN_NGN=500
# Which provider handles non-African currencies (default: stripe)
# PLATFORM_DEFAULT_PROVIDER=stripe

# Flutterwave (African currencies)
# Get credentials at https://dashboard.flutterwave.com
FLW_PUBLIC_KEY=FLWPUBK_replace_me
FLW_SECRET_KEY=FLWSECK_replace_me
# Required. Webhooks are rejected with 401 when this is unset, so payment
# confirmations will not apply until it is set. This value is NOT generated by
# Flutterwave: choose a strong random secret, enter it under
# Dashboard -> Settings -> Webhooks, and set the identical value here.
FLW_SECRET_HASH=your-flutterwave-webhook-secret-hash

# Stripe (EU / international currencies)
# Get credentials at https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_replace_me
# Required. Copy the "Signing secret" from the webhook endpoint you create at
# https://dashboard.stripe.com/test/webhooks (whsec_...).
# Use test/live keys that match the environment Stripe webhooks are sent to.
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Split payouts
# Freelancers are paid directly by the provider, so Finsyte never holds their
# money. Set each freelancer's connected account / subaccount id on their user
# record (users.provider_account_id). When it is empty the full amount lands on
# the platform account and must be paid out manually.

